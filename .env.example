# ─── Database ───
# Local docker instance (compose.dev.yml): postgresql://dealflow:dealflow_dev@127.0.0.1:55432/dealflow_dev?schema=public
# Hosted (e.g. Neon): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
DIRECT_URL=

# ─── Auth ───
AUTH_SECRET=
AUTH_URL=
NEXTAUTH_URL=
AUTH_TRUST_HOST=
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=
BCRYPT_SALT_ROUNDS=
ADMIN_BOOTSTRAP_EMAIL=
JOBS_SECRET=
CRON_SECRET=

# ─── SMTP / Nodemailer ───
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=

# ─── Uploads ───
MAX_FILE_SIZE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Read-only assistant (services/assistant) ───
# The assistant connects as a SELECT-only Postgres role, never the app role.
# Create it with `pnpm assistant:grant`.
ASSISTANT_DATABASE_URL=postgresql://dealflow_readonly:dealflow_readonly@127.0.0.1:55432/dealflow_dev
ASSISTANT_DB_PASSWORD=dealflow_readonly
# Shared secret between the Next.js proxy and the FastAPI service.
ASSISTANT_SERVICE_KEY=
ASSISTANT_URL=http://127.0.0.1:8000

# LLM — OpenCode gateway (OpenAI-compatible). It fronts several upstream
# providers. A model stops working the moment its provider's daily quota is
# spent — sometimes while still advertised in /v1/models — so requests fall back
# down LLM_FALLBACK_MODELS in order on 429/503.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=ag/claude-sonnet-4-6
LLM_FALLBACK_MODELS=

# Ceiling on rows handed back to the model in one query.
ASSISTANT_MAX_RESULT_ROWS=30
