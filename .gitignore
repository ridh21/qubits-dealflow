/playwright-report/
/test-results/

# Container seeder / package-manager artifacts (any depth)
.pnpm-store/

# Python assistant service (services/assistant)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Retired code/ subdirectory from before the repo was flattened
/code/

